// This file is read-only and lives in
//
//    $DATA/Installed Packages/LSP-anakin.sublime-package
//
// Provided you installed this package through Package Control. To modify one
// of these settings, you should see a template file to your right where you
// can override various key-value pairs.
//
// It is safe to partially override the "settings" key.
//
// After making changes you must *save* the *right* view in
// $DATA/Packages/User/LSP-anakin.sublime-settings.
{
    "command": [
        "$anakinls"
    ],
    "selector": "source.python",
    "version": "1.23",
    // The Python interpreter used to create the virtual environment for anakin-language-server. Empty to use
    // "python3" ("python" on Windows) from the PATH. anakin-language-server doesn't support Python 3.14 yet.
    // After changing it, delete the $cache_path/LSP-anakin directory so that the environment is created again.
    "python": "",
    "initialization_options": {
        // "venv": "path/to/virtualenv"
    },
    "env": {
        "PYTHONPATH": "$sublime_py_files_dir:$sublime_packages_dir",
        "MYPY_PATH": "$sublime_py_files_dir:$sublime_packages_dir"
    },
    "settings": {
        "anakinls.pyflakes_errors": [
            "undefined-name"
        ],
        "anakinls.help_on_hover": true,
        "anakinls.mypy_enabled": false,
        "anakinls.pycodestyle_config": null,
        "anakinls.completion_snippet_first": false,
        "anakinls.yapf_style_config": "pep8"
    },
}
